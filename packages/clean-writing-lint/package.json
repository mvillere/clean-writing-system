{
  "name": "clean-writing-lint",
  "version": "0.1.0",
  "description": "Lint prose for AI slop. Checks the machine-checkable subset of Simplified Technical English in markdown, code comments, and release notes.",
  "type": "module",
  "license": "MIT",
  "author": "Michael Villere",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvillere/clean-writing-system.git",
    "directory": "packages/clean-writing-lint"
  },
  "keywords": [
    "lint",
    "prose",
    "writing",
    "documentation",
    "ai-slop",
    "simplified-technical-english",
    "ste",
    "asd-ste100"
  ],
  "bin": {
    "cwlint": "./bin/cwlint.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./wordlists": "./src/wordlists.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "lint:self": "node bin/cwlint.js ../../README.md ../../AGENTS.md ../../writing-systems"
  },
  "homepage": "https://github.com/mvillere/clean-writing-system/tree/main/packages/clean-writing-lint",
  "bugs": {
    "url": "https://github.com/mvillere/clean-writing-system/issues"
  }
}
